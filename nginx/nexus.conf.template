server {
    listen 80;
    server_name ${NEXUS_DOMAIN} ${REGISTRY_1_DOMAIN} ${REGISTRY_2_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${NEXUS_DOMAIN};
    ssl_certificate     /etc/nginx/certs/${NEXUS_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/${NEXUS_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://nexus:8081;
    }
}

server {
    listen 443 ssl;
    server_name ${REGISTRY_1_DOMAIN};
    ssl_certificate     /etc/nginx/certs/${NEXUS_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/${NEXUS_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://nexus:${REGISTRY_1_PORT};
    }
}

server {
    listen 443 ssl;
    server_name ${REGISTRY_2_DOMAIN};
    ssl_certificate     /etc/nginx/certs/${NEXUS_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/${NEXUS_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://nexus:${REGISTRY_2_PORT};
    }
}
